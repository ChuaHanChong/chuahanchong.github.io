{% comment %}
  LOCAL OVERRIDE of al_folio_core's _includes/news.liquid.

  Only change from upstream: the date format is '%b %Y' (e.g. "Aug 2026") instead of
  '%b %d, %Y' ("Aug 11, 2026"). The day is still required in each news file's front
  matter — `site.news | reverse` orders by the full date — it is just not displayed.

  COST: this file is now frozen against the gem. Re-diff it against
  https://github.com/al-org-dev/al-folio-core/blob/main/_includes/news.liquid
  when taking an al-folio upgrade.
  Last synced against: al_folio_core 1.0.15 (al-folio v1.2), Aug 2026.
{% endcomment %}

<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
